@page
@model PortfolioSite.Pages.ContactModel

<div class="container mt-5">

    <h2 class="mb-4 text-center">Get In Touch</h2>

    <div class="row g-4">

        <!-- CONTACT FORM -->
        <div class="col-md-6">
            <div class="card p-4 shadow-sm skill-card">

                <h5 class="mb-3">Send a Message</h5>

                <form>

                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input type="text"
                               class="form-control"
                               id="name"
                               name="name"
                               placeholder="Enter your name"
                               required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email"
                               class="form-control"
                               id="email"
                               name="email"
                               placeholder="Enter your email"
                               required>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Message</label>
                        <textarea class="form-control"
                                  id="message"
                                  name="message"
                                  rows="5"
                                  placeholder="Write your message..."
                                  required></textarea>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-send me-1"></i> Send Message
                    </button>

                </form>

            </div>
        </div>


        <!-- CONTACT INFO -->
        <div class="col-md-6">
            <div class="card p-4 shadow-sm skill-card">

                <h5 class="mb-3">Contact Information</h5>

                <p class="text-muted">
                    Open to DevOps, Cloud, and Automation opportunities.
                    Feel free to reach out for collaborations or discussions.
                </p>

                <!-- CONTACT LINKS -->
                <ul class="list-unstyled mb-4">

                    <li class="mb-3">
                        <i class="bi bi-envelope-fill me-2"></i>
                        <a href="mailto:kumarmarimuthu99@gmail.com" class="text-decoration-none">
                            kumarmarimuthu99@gmail.com
                        </a>
                    </li>

                    <li class="mb-3">
                        <i class="bi bi-github me-2"></i>
                        <a href="https://github.com/Pasupathikumar"
                           target="_blank"
                           class="text-decoration-none">
                            GitHub Profile
                        </a>
                    </li>

                    <li class="mb-3">
                        <i class="bi bi-linkedin me-2"></i>
                        <a href="https://www.linkedin.com/in/pasupathikumar-s-72b8b7208/%22"
                           target="_blank"
                           class="text-decoration-none">
                            LinkedIn Profile
                        </a>
                    </li>

                </ul>

                <!-- LOCATION -->
                <h6 class="mb-2">Location</h6>

                <div class="map-container" style="width:100%; height:280px;">
                    <iframe
                        src="https://www.google.com/maps?q=Hyderabad,India&output=embed"
                        width="100%"
                        height="100%"
                        style="border:0; border-radius:10px;"
                        loading="lazy">
                    </iframe>
                </div>

            </div>
        </div>

    </div>

</div>