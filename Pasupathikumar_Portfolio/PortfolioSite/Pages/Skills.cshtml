@page
@model SkillsModel
@{
    ViewData["Title"] = "Skills";
}

<div class="container mt-5">

    <h1 class="text-center mb-5">My Skills</h1>

    <div class="row g-4">

        <!-- Azure -->
        <div class="col-md-4">
            <div class="card skill-card text-center">
                <div class="card-body">
                    <h4>Azure</h4>
                    <p>Virtual Machines, Networking, Storage, App Services, Container Apps, Function Apps</p>
                </div>
            </div>
        </div>

        <!-- Terraform -->
        <div class="col-md-4">
            <div class="card skill-card text-center">
                <div class="card-body">
                    <h4>Terraform</h4>
                    <p>Infrastructure as Code, Modules, Providers</p>
                </div>
            </div>
        </div>

        <!-- CI/CD -->
        <div class="col-md-4">
            <div class="card skill-card text-center">
                <div class="card-body">
                    <h4>CI/CD</h4>
                    <p>GitHub Actions, Azure DevOps Pipelines</p>
                </div>
            </div>
        </div>

        <!-- Docker -->
        <div class="col-md-4">
            <div class="card skill-card text-center">
                <div class="card-body">
                    <h4>Docker</h4>
                    <p>Containerization and Image Management</p>
                </div>
            </div>
        </div>

        <!-- Linux -->
        <div class="col-md-4">
            <div class="card skill-card text-center">
                <div class="card-body">
                    <h4>Linux</h4>
                    <p>Shell scripting and System Administration</p>
                </div>
            </div>
        </div>

        <!-- Monitoring -->
        <div class="col-md-4">
            <div class="card skill-card text-center">
                <div class="card-body">
                    <h4>Monitoring</h4>
                    <p>Azure Monitor, Log Analytics, Alerts</p>
                </div>
            </div>
        </div>

    </div>

</div>