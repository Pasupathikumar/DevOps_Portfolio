@page
@model SkillsModel
@{
    ViewData["Title"] = "Skills";
}

<div class="portfolio-page skills-page">
    <header class="page-heading">
        <p class="page-eyebrow">CAPABILITIES / CLOUD • DEVOPS • AUTOMATION</p>
        <h1>Technical Skills</h1>
        <p class="page-intro">
            Technologies and practices I use to build, automate, and operate reliable cloud solutions.
        </p>
    </header>

    <section class="skill-domain">
        <div class="domain-heading">
            <span class="domain-index">01</span>
            <div>
                <h2>Cloud &amp; Delivery</h2>
                <p>Cloud platforms, infrastructure as code, and release automation.</p>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">AZ</span>
                        <h3>Azure</h3>
                        <p>Virtual Machines, Networking, Storage, App Services, Container Apps, Function Apps</p>
                    </div>
                </article>
            </div>
            <div class="col-md-4">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">IaC</span>
                        <h3>Terraform</h3>
                        <p>Infrastructure as Code, Modules, Providers</p>
                    </div>
                </article>
            </div>
            <div class="col-md-4">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">CI</span>
                        <h3>CI/CD</h3>
                        <p>GitHub Actions, Azure DevOps Pipelines</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="skill-domain">
        <div class="domain-heading">
            <span class="domain-index">02</span>
            <div>
                <h2>Containers &amp; Orchestration</h2>
                <p>Packaging and orchestrating containerized workloads.</p>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">DK</span>
                        <h3>Docker</h3>
                        <p>Containerization, image builds, and deployment packaging</p>
                    </div>
                </article>
            </div>
            <div class="col-md-6">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">K8s</span>
                        <h3>AKS</h3>
                        <p>Azure Kubernetes Service, cluster deployment, and orchestration</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="skill-domain">
        <div class="domain-heading">
            <span class="domain-index">03</span>
            <div>
                <h2>Operations &amp; Reliability</h2>
                <p>Systems administration, observability, and operational insight.</p>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">OS</span>
                        <h3>Linux</h3>
                        <p>Shell scripting and System Administration</p>
                    </div>
                </article>
            </div>
            <div class="col-md-6">
                <article class="card skill-detail-card h-100">
                    <div class="card-body">
                        <span class="skill-card-mark">OBS</span>
                        <h3>Monitoring</h3>
                        <p>Azure Monitor, Log Analytics, Alerts</p>
                    </div>
                </article>
            </div>
        </div>
    </section>
</div>
