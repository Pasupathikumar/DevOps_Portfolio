@page
@model PortfolioSite.Pages.ExperienceModel
@{
    ViewData["Title"] = "Experience";
}

<div class="portfolio-page experience-page">
    <header class="page-heading">
        <p class="page-eyebrow">CAREER / EXPERIENCE</p>
        <h1>Professional Experience</h1>
        <p class="page-intro">
            A professional journey focused on DevOps, cloud infrastructure, software automation, and applied AI.
        </p>
    </header>

    <div class="experience-ledger">
        <article class="experience-entry current-experience">
            <div class="experience-entry-rail">
                <span class="experience-entry-number">01</span>
                <span class="experience-entry-line"></span>
            </div>
            <div class="experience-entry-card">
                <div class="experience-entry-header">
                    <div>
                        <p class="experience-entry-company">C2S Technologies PVT LTD <span>•</span> Hyderabad</p>
                        <h2>Software Engineer - DevOps Engineer</h2>
                    </div>
                    <span class="experience-date">2024 – Present</span>
                </div>

                <div class="experience-summary-strip">
                    <span><strong>40%</strong> faster deployments</span>
                    <span><strong>60%</strong> less manual effort</span>
                    <span><strong>5+</strong> CI/CD pipelines</span>
                </div>

                <div class="row g-4 experience-details">
                    <div class="col-lg-7">
                        <h3>Key Responsibilities</h3>
                        <ul>
                            <li>Designed and automated Azure infrastructure provisioning using Terraform and ARM templates.</li>
                            <li>Built and optimized CI/CD pipelines in Azure DevOps, improving deployment speed by 40%.</li>
                            <li>Used Docker and Azure Kubernetes Service (AKS) for containerization and orchestration.</li>
                            <li>Managed end-to-end Azure DevOps services including Repos, Boards, Test Plans, and Artifacts.</li>
                            <li>Developed and maintained ADO/GitHub pipelines, reducing build failures and improving pipeline stability.</li>
                            <li>Implemented efficient artifact management strategies for secure and traceable releases.</li>
                            <li>Enhanced infrastructure automation to ensure scalability, reliability, and maintainability.</li>
                            <li>Evaluated and integrated modern DevOps tools to improve team productivity and delivery efficiency.</li>
                        </ul>
                    </div>
                    <div class="col-lg-5">
                        <h3>Key Achievements</h3>
                        <ul>
                            <li>Improved deployment speed by 40% through CI/CD optimization.</li>
                            <li>Automated infrastructure provisioning using Terraform &amp; ARM.</li>
                            <li>Reduced build failures with Github/Azure DevOps pipeline improvements.</li>
                            <li>Strengthened artifact management and release traceability.</li>
                            <li>Implemented Rollback strategies to minimize downtime during deployments.</li>
                        </ul>
                        <h3 class="experience-tech-heading">Technologies</h3>
                        <div class="project-tech-list">
                            <span class="badge">Azure</span><span class="badge">GitHub</span><span class="badge">Terraform</span>
                            <span class="badge">CI/CD</span><span class="badge">Docker</span><span class="badge">AKS</span>
                            <span class="badge">Monitoring</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <article class="experience-entry">
            <div class="experience-entry-rail">
                <span class="experience-entry-number">02</span>
                <span class="experience-entry-line"></span>
            </div>
            <div class="experience-entry-card">
                <div class="experience-entry-header">
                    <div>
                        <p class="experience-entry-company">NextBrain Technologies <span>•</span> Bangalore</p>
                        <h2>Software Automation Engineer Intern</h2>
                    </div>
                    <span class="experience-date">2023 – 2024</span>
                </div>

                <div class="row g-4 experience-details">
                    <div class="col-lg-7">
                        <h3>Key Responsibilities</h3>
                        <ul>
                            <li>Developed face recognition systems using DeepFace and ResNetV2 models.</li>
                            <li>Implemented AI solutions in Python using OpenCV for face detection, encoding, and comparison.</li>
                            <li>Designed and managed SQL databases for storing and processing model data.</li>
                            <li>Utilized Azure compute resources to optimize model performance and data processing.</li>
                            <li>Utilized Azure compute resources to optimize model performance and data processing.</li>
                        </ul>
                    </div>
                    <div class="col-lg-5">
                        <h3>Key Achievements</h3>
                        <ul>
                            <li>Built and deployed AI-based face recognition systems using deep learning models.</li>
                            <li>Improved model performance using Azure-based processing and optimization techniques.</li>
                            <li>Automated dataset collection and model update workflows, reducing manual effort by 50%.</li>
                            <li>Enhanced system accuracy and performance through optimized face encoding techniques.</li>
                        </ul>
                        <h3 class="experience-tech-heading">Technologies</h3>
                        <div class="project-tech-list">
                            <span class="badge">Python</span><span class="badge">Deep Learning Models</span><span class="badge">Automation</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <article class="experience-entry">
            <div class="experience-entry-rail">
                <span class="experience-entry-number">03</span>
            </div>
            <div class="experience-entry-card">
                <div class="experience-entry-header">
                    <div>
                        <p class="experience-entry-company">Shiash Info Tech Solutions <span>•</span> Chennai</p>
                        <h2>Python Developer Intern</h2>
                    </div>
                    <span class="experience-date">2023</span>
                </div>

                <div class="row g-4 experience-details">
                    <div class="col-lg-7">
                        <h3>Key Responsibilities</h3>
                        <ul>
                            <li>Developed basic Python scripts for automation and data handling tasks.</li>
                            <li>Gained practical experience in HTML, CSS, and JavaScript for web development.</li>
                            <li>Worked with SQL queries for data retrieval and database operations.</li>
                            <li>Assisted in debugging and improving application performance.</li>
                            <li>Supported backend and frontend development activities in real-time projects.</li>
                        </ul>
                    </div>
                    <div class="col-lg-5">
                        <h3>Key Achievements</h3>
                        <ul>
                            <li>Built foundational knowledge in Python, web development, and databases.</li>
                            <li>Developed automation scripts to handle repetitive tasks efficiently.</li>
                            <li>Strengthened problem-solving skills through debugging and optimization tasks.</li>
                            <li>Gained hands-on experience working in a real development environment and collaborating with a team.</li>
                        </ul>
                        <h3 class="experience-tech-heading">Technologies</h3>
                        <div class="project-tech-list">
                            <span class="badge">Python</span><span class="badge">HTML</span><span class="badge">CSS</span><span class="badge">SQL</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </div>

    <div class="page-end-action">
        <a asp-page="/Index" class="btn btn-outline-dark">Back to Home</a>
    </div>
</div>
