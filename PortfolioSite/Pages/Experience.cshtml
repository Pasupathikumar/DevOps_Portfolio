@page
@model PortfolioSite.Pages.ExperienceModel
@{
    ViewData["Title"] = "Experience";
}

<div class="portfolio-page experience-page">
    <header class="page-heading">
        <p class="page-eyebrow">CAREER / EXPERIENCE</p>
        <h1>Professional Experience</h1>
        <p class="page-intro">
            A professional journey focused on DevOps, cloud infrastructure, software automation, and applied AI.
        </p>
    </header>

    <div class="experience-ledger">
        <article class="experience-entry current-experience">
            <div class="experience-entry-rail">
                <span class="experience-entry-number">01</span>
                <span class="experience-entry-line"></span>
            </div>
            <div class="experience-entry-card">
                <div class="experience-entry-header">
                    <div>
                        <p class="experience-entry-company">C2S Technologies PVT LTD <span>•</span> Hyderabad</p>
                        <h2>Software Engineer - DevOps Engineer</h2>
                    </div>
                    <span class="experience-date">2024 – Present</span>
                </div>

                <div class="experience-summary-strip">
                    <span><strong>40%</strong> faster deployments</span>
                    <span><strong>60%</strong> less manual effort</span>
                    <span><strong>5+</strong> CI/CD pipelines</span>
                </div>

                <div class="row g-4 experience-details">
                    <div class="col-lg-7">
                        <h3>Key Responsibilities</h3>
                        <ul>
                            <li>Provisioned and managed Azure cloud infrastructure using Terraform, enabling repeatable and standardized deployments across multiple environments.</li>
                            <li>Developed reusable GitHub Actions and Azure DevOps workflows for infrastructure provisioning and application deployments.</li>
                            <li>Improved deployment speed by approximately 40% through CI/CD automation and pipeline optimization.</li>
                            <li>Configured and troubleshot Azure VNets, subnets, NSGs, Private Endpoints, and Private DNS Zones.</li>
                            <li>Investigated infrastructure and application connectivity failures involving DNS resolution, network access, identity permissions, and service configuration.</li>
                            <li>Supported Azure workloads across Storage Accounts, App Services, Function Apps, Container Apps, Event Hubs, and AKS.</li>
                            <li>Automated Azure Databricks workspace and Unity Catalog-related infrastructure using Terraform.</li>
                            <li>Integrated Trivy security scanning into CI/CD pipelines to identify infrastructure and deployment-script vulnerabilities.</li>
                            <li>Automated Databricks database and workspace deployments using Liquibase and Databricks Asset Bundles.</li>
                            <li>Implemented deployment validation and rollback mechanisms to improve release reliability.</li>
                            <li>Configured Grafana dashboards and supported health monitoring for Azure-hosted workloads.</li>
                            <li>Managed access using Azure RBAC, Managed Identities, Service Principals, Microsoft Entra ID, and federated credentials.</li>
                            <li>Maintained multi-repository configurations for infrastructure provisioning, deployment automation, and platform resources.</li>
                            <li>Contributed to workload modernization discussions, including transitions between Azure Container Apps, App Service, and AKS.</li>
                        </ul>
                    </div>
                    <div class="col-lg-5">
                        <h3>Client Delivery</h3>
                        <ul>
                            <li><strong>Taylor Farms:</strong> Azure infrastructure, GitHub Actions, networking, workload support, Databricks automation, and access management.</li>
                            <li><strong>Charlies Produce:</strong> ADLS, Key Vault, Azure Databricks, Trivy security scanning, Liquibase, and Databricks Asset Bundles.</li>
                            <li><strong>Lindsay:</strong> Azure Container Apps deployments, validation and rollback workflows, Databricks automation, monitoring, and troubleshooting.</li>
                        </ul>
                        <h3>Key Achievements</h3>
                        <ul>
                            <li>Improved deployment speed by 40% through CI/CD optimization.</li>
                            <li>Automated infrastructure provisioning using Terraform &amp; ARM.</li>
                            <li>Reduced build failures with Github/Azure DevOps pipeline improvements.</li>
                            <li>Strengthened artifact management and release traceability.</li>
                            <li>Implemented Rollback strategies to minimize downtime during deployments.</li>
                        </ul>
                        <h3 class="experience-tech-heading">Technologies</h3>
                        <div class="project-tech-list">
                            <span class="badge">Azure</span><span class="badge">GitHub Actions</span><span class="badge">Terraform</span>
                            <span class="badge">CI/CD</span><span class="badge">Docker</span><span class="badge">AKS</span>
                            <span class="badge">Databricks</span><span class="badge">Trivy</span><span class="badge">Grafana</span>
                            <span class="badge">Liquibase</span><span class="badge">Linux</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <article class="experience-entry">
            <div class="experience-entry-rail">
                <span class="experience-entry-number">02</span>
                <span class="experience-entry-line"></span>
            </div>
