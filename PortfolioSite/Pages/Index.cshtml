                <div class="project-tech-list"><span class="badge">Python</span><span class="badge">ResNetV2</span><span class="badge">Azure SQL</span></div>
            </article>

            <article class="home-project-card">
                <div class="project-case-topline"><span class="project-number">03</span><span class="project-kind">ACADEMIC • AI</span></div>
