@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="portfolio-page home-page">
    <section class="home-hero">
        <div class="hero-copy">
            <p class="page-eyebrow">CLOUD • DEVOPS • SOLUTION ARCHITECTURE • AI</p>
            <p class="availability"><span></span> Open to DevOps, Cloud, and Automation opportunities</p>
            <h1>Hi, I'm <span>Pasupathikumar Selvaraj</span></h1>
            <h2>DevOps Engineer</h2>
            <p class="hero-summary">
                DevOps Engineer with 3 years of experience in automating Azure infrastructure, building CI/CD pipelines, and implementing Infrastructure as Code using Terraform and ARM templates. Skilled in Docker, Kubernetes, and cloud-native solutions, with prior experience in AI and automation workflows. Focused on delivering scalable, reliable, and efficient systems.
            </p>

            <div class="hero-tech-list" aria-label="Core technologies">
                <span>Azure</span>
                <span>Terraform</span>
                <span>CI/CD</span>
                <span>Docker</span>
                <span>AKS</span>
                <span>AI Automation</span>
            </div>

            <div class="hero-actions">
                <a asp-page="/Projects" class="btn btn-dark">Explore Projects <span aria-hidden="true">↗</span></a>
                <a asp-page="/Contact" class="btn btn-outline-dark">Contact</a>
                <a href="https://tfstterraform01.blob.core.windows.net/portfolio-docs/Pasupathikumar-Resume.pdf"
                   class="btn btn-outline-dark"
                   target="_blank"
                   rel="noopener noreferrer">Resume <span aria-hidden="true">↓</span></a>
            </div>

            <div class="hero-facts">
                <div><strong>3 years</strong><span>Experience</span></div>
                <div><strong>C2S Technologies</strong><span>Current role</span></div>
                <div><strong>Hyderabad</strong><span>Location</span></div>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-orbit orbit-outer"></div>
            <div class="hero-orbit orbit-inner"></div>
            <div class="hero-image-frame">
                <img src="~/images/Photo.jpg" class="profile-image" alt="Pasupathikumar Selvaraj">
            </div>
            <div class="architecture-chip chip-cloud"><span>01</span> CLOUD</div>
            <div class="architecture-chip chip-delivery"><span>02</span> DELIVERY</div>
            <div class="architecture-chip chip-ai"><span>03</span> AI</div>
            <div class="hero-visual-caption">DESIGN <span>→</span> AUTOMATE <span>→</span> OPERATE</div>
        </div>
    </section>

